{
  "openapi": "3.0.3",
  "info": {
    "title": "Task Service API",
    "version": "2.0.0",
    "description": "CRUD API для управления задачами с поддержкой периодичности"
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Локальный сервер"
    }
  ],
  "tags": [
    {
      "name": "Tasks",
      "description": "Операции с задачами"
    }
  ],
  "paths": {
    "/api/v1/tasks": {
      "get": {
        "tags": ["Tasks"],
        "summary": "Получить список всех задач",
        "description": "Возвращает все задачи (включая периодические шаблоны)",
        "responses": {
          "200": {
            "description": "Список задач",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Task"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Tasks"],
        "summary": "Создать новую задачу",
        "description": "Создает задачу. Можно указать тип периодичности и правило повторения",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTaskRequest"
              },
              "examples": {
                "regular": {
                  "summary": "Обычная задача",
                  "value": {
                    "title": "Подготовить отчет",
                    "description": "Собрать данные за квартал",
                    "status": "new"
                  }
                },
                "daily": {
                  "summary": "Ежедневная задача",
                  "value": {
                    "title": "Обзвон пациентов",
                    "description": "Ежедневный обзвон",
                    "status": "new",
                    "recurrence_type": "daily",
                    "recurrence_rule": {
                      "interval": 1,
                      "start_date": "2026-04-19"
                    }
                  }
                },
                "monthly": {
                  "summary": "Ежемесячная задача",
                  "value": {
                    "title": "Инвентаризация",
                    "recurrence_type": "monthly",
                    "recurrence_rule": {
                      "day_of_month": 15
                    }
                  }
                },
                "specific_dates": {
                  "summary": "На конкретные даты",
                  "value": {
                    "title": "Праздничный обход",
                    "recurrence_type": "specific_dates",
                    "recurrence_rule": {
                      "dates": ["2026-12-25", "2026-12-31", "2027-01-01"]
                    }
                  }
                },
                "odd_even": {
                  "summary": "По четным дням",
                  "value": {
                    "title": "Отчетность",
                    "recurrence_type": "odd_even",
                    "recurrence_rule": {
                      "day_type": "even"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Задача создана",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Task"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          }
        }
      }
    },
    "/api/v1/tasks/date": {
      "get": {
        "tags": ["Tasks"],
        "summary": "Получить задачи на конкретную дату",
        "description": "Возвращает все задачи, активные на указанную дату (включая периодические)",
        "parameters": [
          {
            "name": "date",
            "in": "query",
            "description": "Дата в формате YYYY-MM-DD (по умолчанию сегодня)",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date",
              "example": "2026-04-20"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Список задач на дату",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Task"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Неверный формат даты",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/tasks/{id}": {
      "get": {
        "tags": ["Tasks"],
        "summary": "Получить задачу по ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "ID задачи",
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1,
              "example": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Задача найдена",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Task"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "put": {
        "tags": ["Tasks"],
        "summary": "Обновить задачу",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateTaskRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Задача обновлена",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Task"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "delete": {
        "tags": ["Tasks"],
        "summary": "Удалить задачу",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Задача удалена"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    }
  },
  "components": {
    "responses": {
      "BadRequest": {
        "description": "Неверный запрос",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": "invalid task input: title is required"
            }
          }
        }
      },
      "NotFound": {
        "description": "Ресурс не найден",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": "task not found"
            }
          }
        }
      }
    },
    "schemas": {
      "CreateTaskRequest": {
        "type": "object",
        "required": ["title"],
        "properties": {
          "title": {
            "type": "string",
            "description": "Название задачи",
            "example": "Подготовить отчет"
          },
          "description": {
            "type": "string",
            "description": "Описание задачи",
            "example": "Собрать данные за квартал"
          },
          "status": {
            "type": "string",
            "description": "Статус задачи",
            "enum": ["new", "in_progress", "done"],
            "default": "new",
            "example": "new"
          },
          "recurrence_type": {
            "type": "string",
            "description": "Тип периодичности",
            "enum": ["none", "daily", "monthly", "specific_dates", "odd_even"],
            "default": "none"
          },
          "recurrence_rule": {
            "$ref": "#/components/schemas/RecurrenceRule"
          }
        }
      },
      "UpdateTaskRequest": {
        "type": "object",
        "required": ["title", "status"],
        "properties": {
          "title": {
            "type": "string",
            "example": "Подготовить отчет"
          },
          "description": {
            "type": "string",
            "example": "Собрать данные за квартал и сделать презентацию"
          },
          "status": {
            "type": "string",
            "enum": ["new", "in_progress", "done"],
            "example": "in_progress"
          },
          "recurrence_type": {
            "type": "string",
            "enum": ["none", "daily", "monthly", "specific_dates", "odd_even"]
          },
          "recurrence_rule": {
            "$ref": "#/components/schemas/RecurrenceRule"
          }
        }
      },
      "RecurrenceRule": {
        "type": "object",
        "description": "Правило повторения задачи. Какие поля заполнять - зависит от recurrence_type",
        "properties": {
          "interval": {
            "type": "integer",
            "description": "Интервал в днях (для daily). 1 = каждый день, 2 = каждый второй день",
            "minimum": 1,
            "example": 7
          },
          "day_of_month": {
            "type": "integer",
            "description": "День месяца (для monthly). От 1 до 31",
            "minimum": 1,
            "maximum": 31,
            "example": 15
          },
          "dates": {
            "type": "array",
            "description": "Список конкретных дат (для specific_dates)",
            "items": {
              "type": "string",
              "format": "date",
              "example": "2026-12-25"
            }
          },
          "day_type": {
            "type": "string",
            "description": "Тип дня (для odd_even)",
            "enum": ["odd", "even"],
            "example": "odd"
          },
          "start_date": {
            "type": "string",
            "format": "date",
            "description": "Дата начала действия правила (опционально)",
            "example": "2026-04-19"
          },
          "end_date": {
            "type": "string",
            "format": "date",
            "description": "Дата окончания действия правила (опционально)",
            "example": "2026-12-31"
          }
        }
      },
      "Task": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "example": 1
          },
          "title": {
            "type": "string",
            "example": "Обзвон пациентов"
          },
          "description": {
            "type": "string",
            "example": "Ежедневный обзвон"
          },
          "status": {
            "type": "string",
            "enum": ["new", "in_progress", "done"],
            "example": "new"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "example": "2026-04-19T00:00:00Z"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "example": "2026-04-19T00:00:00Z"
          },
          "recurrence_type": {
            "type": "string",
            "enum": ["none", "daily", "monthly", "specific_dates", "odd_even"],
            "example": "daily"
          },
          "recurrence_rule": {
            "$ref": "#/components/schemas/RecurrenceRule"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "description": "Сообщение об ошибке",
            "example": "task not found"
          }
        }
      }
    }
  }
}